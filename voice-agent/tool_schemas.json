[
  {
    "type": "function",
    "function": {
      "name": "check_existing_patient",
      "description": "Checks if a patient already exists in the system by their 10-digit US phone number. Call this at the start of every call after receiving the patient's phone number.",
      "parameters": {
        "type": "object",
        "properties": {
          "phone_number": {
            "type": "string",
            "description": "The 10-digit US phone number (e.g. 5419199216 or (541) 919-9216)."
          }
        },
        "required": ["phone_number"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_patient",
      "description": "Registers a new patient with full demographic, contact, and insurance details. Call this after collecting and confirming all mandatory registration fields.",
      "parameters": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "Patient's first name (letters, hyphens, apostrophes only, 1-50 chars)."
          },
          "last_name": {
            "type": "string",
            "description": "Patient's last name (letters, hyphens, apostrophes only, 1-50 chars)."
          },
          "date_of_birth": {
            "type": "string",
            "description": "Date of birth in YYYY-MM-DD format (must not be in the future)."
          },
          "sex": {
            "type": "string",
            "enum": ["Male", "Female", "Other", "Decline to Answer"],
            "description": "Patient's legal sex."
          },
          "phone_number": {
            "type": "string",
            "description": "10-digit US phone number."
          },
          "email": {
            "type": "string",
            "description": "Patient email address (optional)."
          },
          "address_line_1": {
            "type": "string",
            "description": "Street address line 1."
          },
          "address_line_2": {
            "type": "string",
            "description": "Apartment, suite, or unit number (optional)."
          },
          "city": {
            "type": "string",
            "description": "City name."
          },
          "state": {
            "type": "string",
            "description": "Valid 2-letter US state code (e.g. OR, CA, NY, FL)."
          },
          "zip_code": {
            "type": "string",
            "description": "5-digit US ZIP code or ZIP+4 (e.g. 97201 or 97201-1234)."
          },
          "insurance_provider": {
            "type": "string",
            "description": "Insurance provider name (optional)."
          },
          "insurance_member_id": {
            "type": "string",
            "description": "Alphanumeric insurance member ID (optional)."
          },
          "preferred_language": {
            "type": "string",
            "description": "Preferred language for care (optional, default English)."
          },
          "emergency_contact_name": {
            "type": "string",
            "description": "Full name of emergency contact (optional)."
          },
          "emergency_contact_phone": {
            "type": "string",
            "description": "10-digit US phone number for emergency contact (optional)."
          }
        },
        "required": [
          "first_name",
          "last_name",
          "date_of_birth",
          "sex",
          "phone_number",
          "address_line_1",
          "city",
          "state",
          "zip_code"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_patient",
      "description": "Updates an existing patient's details by their patient_id. Call this when an existing patient requests updates to their profile.",
      "parameters": {
        "type": "object",
        "properties": {
          "patient_id": {
            "type": "string",
            "description": "The unique UUID of the patient record to update."
          },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "date_of_birth": { "type": "string" },
          "sex": {
            "type": "string",
            "enum": ["Male", "Female", "Other", "Decline to Answer"]
          },
          "phone_number": { "type": "string" },
          "email": { "type": "string" },
          "address_line_1": { "type": "string" },
          "address_line_2": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "zip_code": { "type": "string" },
          "insurance_provider": { "type": "string" },
          "insurance_member_id": { "type": "string" },
          "preferred_language": { "type": "string" },
          "emergency_contact_name": { "type": "string" },
          "emergency_contact_phone": { "type": "string" }
        },
        "required": ["patient_id"]
      }
    }
  }
]
